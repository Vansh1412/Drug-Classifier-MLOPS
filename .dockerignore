# ─────────────────────────────────────────────────────────────
# .dockerignore — MedMLOps-X Docker Build Context Exclusion
# ─────────────────────────────────────────────────────────────

# Version control & CI
.git
.gitignore
.github

# Virtual environments
.venv
venv
env
ENV

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# MLOps Experiment Tracking & Lineage (local databases)
mlruns/
mlruns.db
mlartifacts/

# DVC internal cache & local temp
.dvc/cache/
.dvc/tmp/

# Sensitive files & secrets
.env
.env.*
*.pem
*.key

# Development, tests, and documentation
tests/
docs/
notebook.ipynb
deploy.sh
Makefile
sprint*.md
*.log
